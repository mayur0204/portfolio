# Copy to .env and fill in. .env is git-ignored — never commit real keys.
#
# Optional: enables AI answers for the "Ask Mayur" assistant (Anthropic API key).
# Without it, the assistant answers from src/data/* using the built-in local engine.
AI_API_KEY=your_api_key_here

# Optional: override the model (default: claude-opus-5)
# AI_MODEL=claude-opus-5
